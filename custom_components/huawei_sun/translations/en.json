{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the inverter",
        "description": "Enter the Modbus TCP address of the SUN2000. Port 8899 and unit ID 1 are the Huawei defaults.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "host": "IP address or hostname of the inverter or its Modbus bridge.",
          "port": "Modbus TCP port. Huawei inverters normally listen on 8899.",
          "unit_id": "Modbus unit (slave) ID. Huawei inverters normally use 1."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not read the inverter. Check the address, the unit ID and that Modbus TCP is enabled on the device."
    },
    "abort": {
